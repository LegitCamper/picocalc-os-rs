+pub fn validate_abi(
+    bytes: &[u8; 12],
+    kernel_minor: u16,
+    available_entries: usize,
+) -> Result<usize, LoadError> {
+    let count = half(bytes, 8) as usize;
+    if bytes[..4] != *b"PCOS"
+        || half(bytes, 4) != 2
+        || half(bytes, 6) > kernel_minor
+        || half(bytes, 6) != 0
+        || count != 18
+        || count > available_entries
+        || half(bytes, 10) != 0
+    {
+        return Err(LoadError::AbiMismatch);
+    }
+    Ok(count)
